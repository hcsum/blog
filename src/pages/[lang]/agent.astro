---
import AgentPage from "@/components/pages/AgentPage.astro";
import { PREFIXED_LOCALES, type Locale } from "@/i18n/config";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---

<AgentPage locale={locale} />
