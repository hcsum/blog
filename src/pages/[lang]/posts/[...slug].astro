---
import { getCollection } from "astro:content";
import PostPage from "@/components/pages/PostPage.astro";
import { PREFIXED_LOCALES, type Locale } from "@/i18n/config";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return PREFIXED_LOCALES.flatMap((lang) =>
    posts.map((post) => ({
      params: { lang, slug: post.id },
      props: { post },
    })),
  );
}

const { post } = Astro.props;
const locale = Astro.params.lang as Locale;
---

<PostPage post={post} locale={locale} />
